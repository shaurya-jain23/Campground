<% layout('./layouts/layout') %>

<% if(title === 'All Campgrounds') { %>
    <div id="cluster-map"></div>
    <% } %>
    
    <div class="container mt-5">
        <h1 class="mb-4 text-center fw-bold animate__animated animate__fadeInDown"><%= title %></h1>
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        <% for(let campground of campgrounds){ %>
        <div class="col" data-aos="fade-up" data-aos-duration="1000">
            <div class="card h-100 shadow-sm border-0 hover-shadow transition-all">
                <% if(campground.images.length) { %>
                    <img src="<%= campground.images[0].url %>" class="card-img-top" alt="<%= campground.title %>" style="height: 250px; object-fit: cover;">
                <% } else { %>
                    <img src="https://res.cloudinary.com/doykrr6zz/image/upload/v1748064661/YelpCamp/fqqov5xjawymoyrwe8ic.jpg" class="card-img-top" alt="<%= campground.title %>" style="height: 250px; object-fit: cover;">
                <% } %>
                
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold"><%= campground.title %></h5>
                    <p class="card-text text-secondary mb-4 flex-grow-1">
                        <%= campground.description.length > 100 ? campground.description.substring(0, 100) + '...' : campground.description %>
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <small class="text-muted">
                            <i class="bi bi-geo-alt-fill me-1"></i><%= campground.location %>
                        </small>
                        <a href="/campgrounds/<%= campground._id %>" class="btn btn-outline-primary rounded-pill btn-sm px-3">View Details</a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
    </div>
</div>

<script>
    const mapToken = '<%- process.env.MAPBOX_TOKEN %>';
    const campgrounds = {features: <%- JSON.stringify(campgrounds) %>}
</script>
<script src="/javascripts/clusterMap.js"></script>