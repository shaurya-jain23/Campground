<!DOCTYPE html>
<html lang="en" class="h-100" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YelpCamp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/layout.css">
    
    <!-- Custom Home Styles -->
    <style>
        body {
            height: 100vh;
            background-color: var(--body-bg);
            text-shadow: 0 0.05rem 0.1rem rgba(0, 0, 0, 0.5);
            box-shadow: inset 0 0 5rem rgba(0, 0, 0, 0.5);
        }

        .cover-container {
            max-width: 60vw;
        }

        .nav-masthead .nav-link {
            color: rgba(255, 255, 255, .5);
            border-bottom: .25rem solid transparent;
        }

        .nav-masthead .nav-link:hover,
        .nav-masthead .nav-link:focus {
            border-bottom-color: rgba(255, 255, 255, .25);
        }

        .nav-masthead .nav-link + .nav-link {
            margin-left: 1rem;
        }

        .nav-masthead .active {
            color: #fff;
            border-bottom-color: #fff;
        }

        /* Hero Background */
        .bg-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background-image: url('https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80');
            background-size: cover;
            background-position: center;
            filter: brightness(0.7);
        }
        
        /* Glass card for content */
        .glass-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 3rem;
            border-radius: 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        }
    </style>
</head>
<body class="d-flex text-center text-white bg-dark">

    <div class="bg-image"></div>

    <main class="text-center text-white h-100 w-100">
        <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column justify-content-center align-items-center">
            
            <div class="glass-card p-5 rounded-4 animate__animated animate__fadeInUp">
                <h1 class="display-3 fw-bold mb-3 animate__animated animate__pulse animate__delay-1s">YelpCamp</h1>
                <p class="lead mb-4 animate__animated animate__fadeIn animate__delay-1s">
                    Discover and review the best campgrounds from all over the world. <br> 
                    Share your own experiences and find your next adventure.
                </p>
                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center animate__animated animate__fadeInUp animate__delay-1s">
                    <a href="/campgrounds" class="btn btn-lg btn-light fw-bold px-4 gap-3">View Campgrounds</a>
                    <% if(!currentUser) { %>
                    <a href="/register" class="btn btn-lg btn-outline-light fw-bold px-4">Join Now</a>
                    <% } %>
                </div>
            </div>

            <footer class="text-white-50 animate__animated animate__fadeIn animate__delay-2s">
                <p>&copy; 2024 YelpCamp</p>
            </footer>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"></script>
</body>
</html>
